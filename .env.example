# App
NODE_ENV=production
PORT=5001
FRONTEND_URL=https://your-app.vercel.app

# Frontend (set this in Vercel dashboard under Environment Variables)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/afrimarket_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=AfriGrowth <noreply@afrigrowth.com>

# Social Media
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# AWS (for file storage)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=af-south-1
AWS_S3_BUCKET=afrigrowth-uploads

# Encryption
ENCRYPTION_KEY=32-char-encryption-key-here!!!

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
